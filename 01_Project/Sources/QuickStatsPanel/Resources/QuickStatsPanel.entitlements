<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox is OFF: the Mach host-statistics calls used by the samplers
         (host_statistics / host_statistics64) are restricted under the sandbox.
         Matches StatsWindow. Revisit before any Mac App Store distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
